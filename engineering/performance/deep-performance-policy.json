  "targets": [
    {
      "id": "PERF-DEEP-PILOT-CONTEXT-PROJECTION",
      "performance_target_id": "PERF-TGT-PILOT-CONTEXT-PROJECTION",
      "kind": "resource",
      "handler_key": "builtin-pilot-context-projection-v1",
      "stages": [
        "on-demand"
      ],
      "trigger_paths": [
        "product-runtime/context-envelope/**",
        "engineering/pilot/**"
      ],
      "duration_seconds": 0,
      "timeout_seconds": 30,
      "memory_limit_mib": 128,
      "concurrency": 1,
      "iterations": 10000,
      "rationale": "Pre-register bounded resource validation with the runtime boundary. The compiled handler remains intentionally unavailable until E9-C implements the projection; PR only validates this policy and does not execute the on-demand target."
    }
  ]
}
