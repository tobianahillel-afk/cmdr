{
  "schema_version": 1,
  "contract_id": "EVENT-SEARCH-EXECUTABLE-CONTRACT-V1",
  "contract_kind": "backend-neutral-local-executable-contract",
  "canonical_schema_claim": false,
  "capability": "CAP-INV-002",
  "screen": "INV-EVS-001",
  "runtime_boundary": {
    "id": "event-search-runtime",
    "root": "product-runtime/event-search/**",
    "expected_state": "implemented",
    "external_runtime_dependencies": []
  },
  "product_refs": {
    "capabilities": [
      "CAP-INV-002"
    ],
    "requirements": [
      "REQ-PROD-005",
      "REQ-PROD-010",
      "REQ-PROD-011",
      "REQ-PROD-014",
      "REQ-PROD-045"
    ],
    "screens": [
      "INV-EVS-001"
    ],
    "permissions": [
      "perm.investigate.search.execute",
      "perm.shared-capabilities.query.read",
      "perm.shared-capabilities.query.manage",
      "perm.shared-capabilities.search-job.read",
      "perm.shared-capabilities.search-job.manage",
      "perm.shared-capabilities.telemetry-event.read"
    ],
    "open_decisions": [
      "OPEN-013"
    ],
    "implementation_contracts": [
      "cmdr-product-spec/17-implementation-contracts/search-query-contract.md",
      "cmdr-product-spec/17-implementation-contracts/background-job-contract.md",
      "cmdr-product-spec/17-implementation-contracts/tenant-scope-contract.md",
      "cmdr-product-spec/17-implementation-contracts/permission-enforcement-contract.md",
      "cmdr-product-spec/17-implementation-contracts/audit-event-contract.md",
      "cmdr-product-spec/17-implementation-contracts/error-contract.md",
      "cmdr-product-spec/17-implementation-contracts/correlation-identifiers.md"
    ],
    "canonical_objects": [
      "cmdr-product-spec/05-domain-model/objects/query.md",
      "cmdr-product-spec/05-domain-model/objects/search-job.md",
      "cmdr-product-spec/05-domain-model/objects/telemetry-event.md"
    ]
  },
  "scope_policy": {
    "tenant_required": true,
    "environment_required": true,
    "time_range_required": true,
    "sources_required": true,
    "wildcard_tenant_forbidden": true,
    "cross_tenant_forbidden": true,
    "empty_sources_forbidden": true
  },
  "permission_policy": {
    "server_evaluation_required": true,
    "client_trust_forbidden": true,
    "required_execution_permissions": [
      "perm.investigate.search.execute",
      "perm.shared-capabilities.query.read",
      "perm.shared-capabilities.search-job.manage",
      "perm.shared-capabilities.telemetry-event.read"
    ],
    "inspection_permission": "perm.shared-capabilities.search-job.read",
    "query_management_permission": "perm.shared-capabilities.query.manage",
    "deny_masks_protected_data": true,
    "raw_access_is_separate": true
  },
  "query_policy": {
    "query_required": true,
    "validation_before_execution": true,
    "deterministic_manual_path_required": true,
    "ai_execution_without_explicit_trigger_forbidden": true,
    "final_query_language_selected": false,
    "final_index_selected": false,
    "final_storage_engine_selected": false,
    "final_provider_selected": false
  },
  "search_job_policy": {
    "states": [
      "queued",
      "running",
      "completed",
      "partial",
      "failed",
      "cancelled"
    ],
    "terminal_states": [
      "completed",
      "partial",
      "failed",
      "cancelled"
    ],
    "allowed_transitions": [
      "queued->running",
      "queued->cancelled",
      "running->completed",
      "running->partial",
      "running->failed",
      "running->cancelled"
    ],
    "relaunch_creates_new_job": true,
    "cancellation_audited": true,
    "partial_preserves_valid_results": true,
    "failed_sources_visible": true,
    "no_complete_result_simulation": true
  },
  "audit_policy": {
    "actor_required": true,
    "tenant_required": true,
    "action_required": true,
    "target_required": true,
    "outcome_required": true,
    "rationale_required": true,
    "correlation_id_required": true,
    "query_version_required": true,
    "period_required": true,
    "sources_required": true,
    "run_id_required": true,
    "errors_recorded": true,
    "sensitive_data_forbidden_in_correlation_id": true
  },
  "performance_budget": {
    "validation_p95_ms": 1,
    "orchestration_p95_ms": 1,
    "production_search_slo_claim": false
  },
  "exclusions": [
    "case-link-mutation:OPEN-013",
    "final-ui",
    "final-query-language",
    "final-index",
    "final-storage-engine",
    "final-provider"
  ],
  "semantic_rules": [
    "execution requires explicit tenant environment ordered time range and at least one authorized source",
    "tenant wildcard and cross-tenant execution are rejected",
    "query validation completes before execution is accepted",
    "permission evaluation is server-side and denied execution reveals no protected event content",
    "partial jobs preserve valid results and identify failed sources",
    "terminal Search Job states have no in-place restart transition; relaunch creates a new job",
    "every execution attempt and lifecycle mutation is auditable and correlation-addressable",
    "result completeness is never simulated when a source fails or data is stale",
    "raw event access remains a separate permission concern",
    "Case-link mutation is excluded while OPEN-013 remains unresolved"
  ],
  "security_invariants": [
    "single-selected-Tenant only",
    "no wildcard tenant fallback",
    "no client authorization trust",
    "no protected data disclosure on permission denial",
    "no silent source widening",
    "no silent complete-result claim after partial failure",
    "no Case-link mutation under OPEN-013",
    "no query language index storage engine or provider selection"
  ]
}
