{
  "schema_version": 1,
  "contract_id": "QUERY-ASSET-READONLY-CONTRACT-V1",
  "contract_kind": "provider-neutral-readonly-local-executable-contract",
  "canonical_schema_claim": false,
  "capability": "CAP-INV-006",
  "runtime_boundary": {
    "id": "saved-query-assets-runtime",
    "root": "product-runtime/saved-query-assets/**",
    "expected_state": "preimplementation",
    "external_runtime_dependencies": []
  },
  "product_refs": {
    "capabilities": [
      "CAP-INV-006",
      "CAP-INV-002",
      "CAP-INV-005"
    ],
    "requirements": [
      "REQ-PROD-014",
      "REQ-PROD-020"
    ],
    "screens": [],
    "permissions": [],
    "open_decisions": [
      "OPEN-013"
    ],
    "implementation_contracts": [
      "cmdr-product-spec/17-implementation-contracts/tenant-scope-contract.md",
      "cmdr-product-spec/17-implementation-contracts/permission-enforcement-contract.md",
      "cmdr-product-spec/17-implementation-contracts/audit-event-contract.md",
      "cmdr-product-spec/17-implementation-contracts/error-contract.md",
      "cmdr-product-spec/17-implementation-contracts/correlation-identifiers.md",
      "cmdr-product-spec/17-implementation-contracts/object-reference-contract.md",
      "cmdr-product-spec/17-implementation-contracts/search-query-contract.md"
    ],
    "canonical_objects": [
      "cmdr-product-spec/05-domain-model/objects/query.md",
      "cmdr-product-spec/05-domain-model/objects/search-job.md"
    ]
  },
  "scope_policy": {
    "tenant_required": true,
    "environment_required": true,
    "wildcard_tenant_forbidden": true,
    "cross_tenant_forbidden": true
  },
  "asset_policy": {
    "allowed_kinds": [
      "saved-search",
      "query-asset"
    ],
    "stable_identifier_required": true,
    "caller_access_decision_required": true,
    "denied_projection_forbidden": true,
    "author_required": true,
    "validation_state_required": true,
    "parameters_preserved": true,
    "lineage_preserved_when_present": true,
    "deprecation_metadata_readonly": true
  },
  "query_policy": {
    "shared_owned": true,
    "tenant_scoped": true,
    "stable_identifier_required": true,
    "exact_version_required": true,
    "caller_access_decision_required": true,
    "denied_projection_forbidden": true,
    "ownership_transfer_forbidden": true
  },
  "compatibility_policy": {
    "source_prerequisites_required": true,
    "source_tenant_must_match_asset": true,
    "missing_source_incompatible": true,
    "missing_or_removed_field_incompatible": true,
    "stale_prerequisite_visible": true,
    "stale_validation_visible": true,
    "deterministic_sorted_diagnostics": true,
    "synthesis_of_missing_facts_forbidden": true
  },
  "projection_policy": {
    "immutable": true,
    "deep_copy_isolation": true,
    "query_identity_visible": true,
    "parameter_metadata_visible": true,
    "source_field_prerequisites_visible": true,
    "author_validation_provenance_visible": true,
    "compatibility_visible": true,
    "handoff_only_when_compatible": true
  },
  "mutation_policy": {
    "saved_search_create_executable": false,
    "saved_search_update_executable": false,
    "share_executable": false,
    "duplicate_executable": false,
    "deprecate_executable": false,
    "archive_executable": false,
    "query_mutation_executable": false,
    "saved_view_mutation_executable": false,
    "detection_rule_conversion_executable": false,
    "search_job_creation_executable": false,
    "search_job_execution_executable": false
  },
  "technology_policy": {
    "storage_engine_selected": false,
    "version_store_selected": false,
    "provider_selected": false,
    "retention_policy_selected": false,
    "collaboration_backend_selected": false,
    "approval_policy_selected": false,
    "revalidation_policy_selected": false,
    "final_query_dialect_selected": false,
    "final_ui_selected": false
  },
  "exclusions": [
    "saved-search-mutation:OPEN-013",
    "query-asset-mutation:OPEN-013",
    "query-mutation-or-ownership-transfer",
    "saved-view-mutation-or-conceptual-merge",
    "detection-rule-creation-conversion-deployment",
    "search-job-creation-or-execution",
    "cross-tenant-copy",
    "storage-version-store-provider-retention",
    "collaboration-approval-revalidation-policy",
    "final-query-dialect",
    "final-cap-inv-006-ui"
  ],
  "semantic_rules": [
    "The bounded runtime validates and projects a caller-owned Saved Search or Query Asset snapshot rather than defining a canonical Saved Search schema",
    "Query remains owned by Shared Capabilities and is referenced by stable immutable identity plus exact version",
    "Search Job remains owned by Shared Capabilities and is neither created nor executed by this runtime",
    "Saved View remains a separate Shared-owned presentation concept and is never merged with a Saved Search or Query Asset",
    "Detection Rule remains separate and is never created converted or deployed by this runtime",
    "source and field prerequisites are caller-resolved facts; missing or removed prerequisites become deterministic incompatibility diagnostics",
    "stale prerequisites or validation remain visible and make the asset ineligible for execution handoff",
    "execution handoff eligibility requires compatible prerequisites and preserves original Query/version identity",
    "OPEN-013 keeps all class-2 asset mutation outside this bounded contract"
  ],
  "security_invariants": [
    "single-selected-Tenant only",
    "no wildcard tenant fallback",
    "no cross-tenant asset Query source or handoff scope",
    "caller-provided access decisions are required for the asset and Query",
    "denied asset or Query access exposes no usable projection",
    "projection is immutable and deep-copy isolated from caller input",
    "missing facts are diagnosed rather than synthesized",
    "no class-2 mutation or Search Job creation/execution occurs"
  ]
}
