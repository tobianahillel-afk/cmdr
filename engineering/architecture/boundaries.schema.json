{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdr.local/schema/architecture-boundaries-v1.schema.json",
  "title": "CMDR architecture boundary registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_policy",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "default_policy": {
      "const": "deny-unregistered-path"
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "roots",
          "mutable_by_implementation",
          "may_depend_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "roots": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mutable_by_implementation": {
            "type": "boolean"
          },
          "may_depend_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
