{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdr.local/schema/validation-check-catalog-v1.schema.json",
  "title": "CMDR validation check catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_policy",
    "risk_domains",
    "cost_tiers",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "default_policy": {
      "const": "deny-unknown-check"
    },
    "risk_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "cost_tiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fast",
          "standard",
          "heavy"
        ]
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "executor_key",
          "risk_domains",
          "cost_tier",
          "mandatory",
          "always_on_pr",
          "trigger_paths",
          "prerequisites",
          "evidence_kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CHK-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "executor_key": {
            "type": "string",
            "minLength": 1
          },
          "risk_domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "cost_tier": {
            "enum": [
              "fast",
              "standard",
              "heavy"
            ]
          },
          "mandatory": {
            "type": "boolean"
          },
          "always_on_pr": {
            "type": "boolean"
          },
          "trigger_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prerequisites": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CHK-[A-Z0-9-]+$"
            }
          },
          "evidence_kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
