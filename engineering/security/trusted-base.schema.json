{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdr.local/schema/trusted-base-v1.schema.json",
  "title": "CMDR Trusted Base",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_policy",
    "runtime_exceptions",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "default_policy": {
      "const": "deny-third-party-product-functionality"
    },
    "runtime_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ecosystem",
          "name",
          "allowed_versions",
          "purpose",
          "provenance",
          "license",
          "security_review",
          "telemetry",
          "replacement_boundary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ecosystem": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "allowed_versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "security_review": {
            "type": "string",
            "minLength": 1
          },
          "telemetry": {
            "type": "string",
            "minLength": 1
          },
          "replacement_boundary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
